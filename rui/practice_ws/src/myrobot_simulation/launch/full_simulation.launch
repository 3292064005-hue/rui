<launch>
    <!-- Full Gazebo-only simulation bringup: base, wheel joints, lidar, camera, IMU and health monitor. -->
    <arg name="world_name" default="$(find myrobot_description)/worlds/rm_map.world" />
    <arg name="gui" default="true" />
    <arg name="paused" default="false" />
    <arg name="launch_rviz" default="true" />
    <arg name="start_test_motion" default="false" />
    <arg name="rviz_config" default="$(find myrobot_simulation)/config/simulation.rviz" />

    <include file="$(find myrobot_simulation)/launch/mycar_gazebo.launch">
        <arg name="world_name" value="$(arg world_name)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="launch_rviz" value="$(arg launch_rviz)" />
        <arg name="rviz_config" value="$(arg rviz_config)" />
        <arg name="enable_planar_drive" value="true" />
        <arg name="enable_lidar" value="true" />
        <arg name="enable_camera" value="true" />
        <arg name="enable_imu" value="true" />
        <arg name="start_wheel_joint_driver" value="true" />
        <arg name="start_sim_monitor" value="true" />
        <arg name="publish_fake_joint_states" value="false" />
    </include>

    <node if="$(arg start_test_motion)"
          pkg="myrobot_simulation"
          type="cmd_vel_test_motion.py"
          name="cmd_vel_test_motion"
          output="screen" />
</launch>
