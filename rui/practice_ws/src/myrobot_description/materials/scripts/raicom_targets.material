material RAICOM/Zone1Panel
{
  technique
  {
    pass
    {
      lighting off
      ambient 1 1 1 1
      diffuse 1 1 1 1
      specular 0 0 0 1
      emissive 1 1 1 1
      scene_blend one zero
      depth_check on
      depth_write on
      alpha_rejection greater_equal 128
      texture_unit
      {
        texture zone1_panel.jpg
        filtering anisotropic
        max_anisotropy 16
      }
    }
  }
}

material RAICOM/Zone2Panel
{
  technique
  {
    pass
    {
      lighting off
      ambient 1 1 1 1
      diffuse 1 1 1 1
      specular 0 0 0 1
      emissive 1 1 1 1
      scene_blend one zero
      depth_check on
      depth_write on
      alpha_rejection greater_equal 128
      texture_unit
      {
        texture zone2_panel.jpg
        filtering anisotropic
        max_anisotropy 16
      }
    }
  }
}
