<launch>
    <!--
      Map-based autonomous navigation stack:
      Gazebo original world + map_server + AMCL + move_base.
      worlds/rm_map.world is not modified. The default map is generated from that world geometry.
    -->
    <arg name="map_file" default="$(find myrobot_description)/maps/raicom_slam_map_final.yaml" />
    <arg name="nav_params" default="$(find myrobot_description)/config/navigation_params.yaml" />
    <arg name="world_name" default="$(find myrobot_description)/worlds/rm_map.world" />
    <arg name="launch_rviz" default="true" />
    <arg name="gui" default="true" />
    <arg name="paused" default="false" />
    <arg name="rviz_config" default="$(find myrobot_description)/config/navigation.rviz" />
    <arg name="use_sim_time" default="true" />
    <arg name="auto_initial_pose" default="true" />
    <arg name="enable_health_monitor" default="true" />
    <arg name="scan_topic" default="/scan_filtered" />
    <arg name="raw_scan_topic" default="/scan" />

    <arg name="initial_pose_x" default="0.0" />
    <arg name="initial_pose_y" default="0.0" />
    <arg name="initial_pose_a" default="-1.5708" />

    <param name="use_sim_time" value="$(arg use_sim_time)" />

    <include file="$(find myrobot_description)/launch/mycar_gazebo.launch">
        <arg name="world_name" value="$(arg world_name)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="launch_rviz" value="false" />
        <arg name="publish_fake_joint_states" value="false" />
        <arg name="enable_planar_drive" value="true" />
        <arg name="enable_lidar" value="true" />
        <arg name="enable_camera" value="true" />
        <arg name="enable_imu" value="true" />
        <arg name="start_wheel_joint_driver" value="true" />
        <arg name="start_sim_monitor" value="false" />
    </include>

    <node pkg="myrobot_description"
          type="scan_self_filter.py"
          name="scan_self_filter"
          output="screen">
        <param name="input_scan_topic" value="$(arg raw_scan_topic)" />
        <param name="output_scan_topic" value="$(arg scan_topic)" />
        <param name="min_valid_range" value="0.18" />
    </node>

    <node pkg="map_server"
          type="map_server"
          name="map_server"
          args="$(arg map_file)"
          output="screen" />

    <node pkg="amcl"
          type="amcl"
          name="amcl"
          output="screen">
        <remap from="scan" to="$(arg scan_topic)" />
        <rosparam command="load" file="$(find myrobot_description)/config/amcl_params.yaml" />
        <param name="initial_pose_x" value="$(arg initial_pose_x)" />
        <param name="initial_pose_y" value="$(arg initial_pose_y)" />
        <param name="initial_pose_a" value="$(arg initial_pose_a)" />
    </node>

    <node if="$(arg auto_initial_pose)"
          pkg="myrobot_description"
          type="navigation_initializer.py"
          name="navigation_initializer"
          output="screen">
        <param name="x" value="$(arg initial_pose_x)" />
        <param name="y" value="$(arg initial_pose_y)" />
        <param name="yaw" value="$(arg initial_pose_a)" />
        <param name="repeat" value="3" />
        <param name="rate" value="2.0" />
    </node>

    <node pkg="move_base"
          type="move_base"
          name="move_base"
          output="screen">
        <remap from="cmd_vel" to="/cmd_vel_raw" />
        <rosparam command="load" file="$(find myrobot_description)/config/move_base_params.yaml" />
        <rosparam command="load" file="$(find myrobot_description)/config/base_local_planner_params.yaml" />
        <rosparam command="load" file="$(find myrobot_description)/config/costmap_common_params.yaml" ns="global_costmap" />
        <rosparam command="load" file="$(find myrobot_description)/config/costmap_common_params.yaml" ns="local_costmap" />
        <rosparam command="load" file="$(find myrobot_description)/config/global_costmap_params.yaml" />
        <rosparam command="load" file="$(find myrobot_description)/config/local_costmap_params.yaml" />
    </node>

    <node pkg="myrobot_description"
          type="cmd_vel_target_yaw_filter.py"
          name="cmd_vel_target_yaw_filter"
          output="screen">
        <rosparam command="load" file="$(arg nav_params)" />
        <param name="input_cmd_vel_topic" value="/cmd_vel_raw" />
        <param name="output_cmd_vel_topic" value="/cmd_vel" />
    </node>

    <node if="$(arg enable_health_monitor)"
          pkg="myrobot_description"
          type="navigation_status_monitor.py"
          name="navigation_status_monitor"
          output="screen">
        <param name="status_topic" value="/navigation_health" />
        <param name="scan_topic" value="$(arg scan_topic)" />
    </node>

    <node if="$(arg launch_rviz)"
          pkg="rviz"
          type="rviz"
          name="rviz_navigation"
          args="-d $(arg rviz_config)" />
</launch>
