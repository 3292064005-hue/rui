<launch>
    <!-- Legacy full task demo: Gazebo + simple /cmd_vel patrol + recognition + evidence logs. -->
    <arg name="launch_rviz" default="true" />
    <arg name="gui" default="true" />
    <arg name="paused" default="false" />
    <arg name="params" default="$(find myrobot_description)/config/task_params.yaml" />
    <arg name="rviz_config" default="$(find myrobot_description)/config/task.rviz" />
    <arg name="enable_evidence_recorder" default="true" />

    <include file="$(find myrobot_description)/launch/mycar_gazebo.launch">
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="launch_rviz" value="$(arg launch_rviz)" />
        <arg name="rviz_config" value="$(arg rviz_config)" />
        <arg name="publish_fake_joint_states" value="false" />
        <arg name="enable_planar_drive" value="true" />
        <arg name="enable_lidar" value="true" />
        <arg name="enable_camera" value="true" />
        <arg name="enable_imu" value="true" />
        <arg name="start_wheel_joint_driver" value="true" />
        <arg name="start_sim_monitor" value="false" />
    </include>

    <node pkg="myrobot_description"
          type="battlefield_recognition.py"
          name="battlefield_recognition"
          output="screen">
        <rosparam command="load" file="$(arg params)" />
    </node>

    <node if="$(arg enable_evidence_recorder)"
          pkg="myrobot_description"
          type="task_evidence_recorder.py"
          name="task_evidence_recorder"
          output="screen">
        <rosparam command="load" file="$(arg params)" />
    </node>

    <node pkg="myrobot_description"
          type="patrol_navigator.py"
          name="patrol_navigator"
          output="screen">
        <rosparam command="load" file="$(arg params)" />
    </node>
</launch>
