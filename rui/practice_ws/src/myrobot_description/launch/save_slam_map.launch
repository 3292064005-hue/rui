<launch>
    <!-- Save the current /map once. Start after slam_mapping.launch has produced a complete map. -->
    <arg name="output_dir" default="$(env HOME)/myrobot_description_maps" />
    <arg name="map_name" default="raicom_slam_map" />
    <arg name="map_topic" default="/map" />
    <arg name="timeout" default="15.0" />

    <node pkg="myrobot_description"
          type="save_slam_map.py"
          name="save_slam_map"
          output="screen"
          required="true">
        <param name="output_dir" value="$(arg output_dir)" />
        <param name="map_name" value="$(arg map_name)" />
        <param name="map_topic" value="$(arg map_topic)" />
        <param name="timeout" value="$(arg timeout)" />
    </node>
</launch>
