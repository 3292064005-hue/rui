<launch>
    <!-- Gazebo simulation launch file. RViz is optional and disabled by default. -->
    <arg name="world_name" default="$(find myrobot_description)/worlds/rm_map.world" />
    <arg name="paused" default="false" />
    <arg name="use_sim_time" default="true" />
    <arg name="gui" default="true" />
    <arg name="headless" default="false" />
    <arg name="debug" default="false" />
    <arg name="launch_rviz" default="false" />
    <arg name="publish_fake_joint_states" default="false" />
    <arg name="enable_planar_drive" default="true" />
    <arg name="enable_lidar" default="true" />
    <arg name="enable_camera" default="true" />
    <arg name="enable_imu" default="true" />
    <arg name="start_wheel_joint_driver" default="true" />
    <arg name="start_sim_monitor" default="false" />
    <arg name="rviz_config" default="$(find myrobot_description)/config/model.rviz" />

    <env name="GAZEBO_RESOURCE_PATH" value="$(find myrobot_description):$(optenv GAZEBO_RESOURCE_PATH)" />
    <param name="use_sim_time" value="$(arg use_sim_time)" />

    <param name="robot_description"
           command="$(find xacro)/xacro $(find myrobot_description)/urdf/turtlebot3_mecanum.urdf.xacro enable_planar_drive:=$(arg enable_planar_drive) enable_lidar:=$(arg enable_lidar) enable_camera:=$(arg enable_camera) enable_imu:=$(arg enable_imu)" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world_name)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="use_sim_time" value="$(arg use_sim_time)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="headless" value="$(arg headless)" />
        <arg name="debug" value="$(arg debug)" />
    </include>

    <node pkg="gazebo_ros"
          type="spawn_model"
          name="spawn_urdf"
          args="-urdf -model mycar -param robot_description -x 0.0 -y 0.0 -z 0.1 -Y -1.5708"
          output="screen" />

    <node pkg="robot_state_publisher"
          type="robot_state_publisher"
          name="robot_state_publisher"
          output="screen" />

    <!-- Static fallback only. Normally disabled because mecanum_sim_driver publishes wheel joint states. -->
    <node if="$(arg publish_fake_joint_states)"
          pkg="joint_state_publisher"
          type="joint_state_publisher"
          name="joint_state_publisher"
          output="screen" />

    <!-- Completes the simulated wheel driver: /cmd_vel -> wheel joint states + wheel speed topic. -->
    <node if="$(arg start_wheel_joint_driver)"
          pkg="myrobot_description"
          type="mecanum_sim_driver.py"
          name="mecanum_sim_driver"
          output="screen">
        <rosparam command="load" file="$(find myrobot_description)/config/simulation_params.yaml" />
    </node>

    <node if="$(arg start_sim_monitor)"
          pkg="myrobot_description"
          type="simulation_status_monitor.py"
          name="simulation_status_monitor"
          output="screen" />

    <node if="$(arg launch_rviz)"
          pkg="rviz"
          type="rviz"
          name="rviz"
          args="-d $(arg rviz_config)" />
</launch>
